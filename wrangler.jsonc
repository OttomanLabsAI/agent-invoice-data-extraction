{
  // The invoice intake agent as a Cloudflare Worker: D1 for the database, R2 for
  // attachments, static assets from public/, a cron trigger for the mailbox sweep.
  // https://developers.cloudflare.com/workers/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-invoice-data-extraction",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "invoice-agent"
    }
  ],
  "r2_buckets": [
    {
      // No bucket_name on purpose: wrangler only creates a bucket for a binding that
      // leaves the name out. The first deploy provisions one called
      // "agent-invoice-data-extraction-files" and later deploys keep using it.
      "binding": "FILES"
    }
  ],
  "triggers": {
    // Fires every five minutes; the "Automatic checks" setting decides whether a run is due.
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
