{
  // The invoice intake agent as a Cloudflare Worker: D1 for the database and the
  // attachments, static assets from public/, a cron trigger for the mailbox sweep.
  // The D1 database is created by name on the first deploy; nothing is made by hand.
  // https://developers.cloudflare.com/workers/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-invoice-data-extraction",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "invoice-agent"
    }
  ],
  "triggers": {
    // Fires every five minutes; the "Automatic checks" setting decides whether a run is due.
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
